# Copy to .env locally. Never commit .env.
POSTGRES_DB=sanad_keycloak
POSTGRES_USER=sanad_keycloak
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

KC_BOOTSTRAP_ADMIN_USERNAME=sanad-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

KEYCLOAK_HOST_PORT=8080
TRANSPORT_API_PORT=5001

# Configure this realm and confidential client before expecting API auth to work.
KEYCLOAK_ISSUER=http://keycloak-transport:8080/realms/sanad-lab
OIDC_CLIENT_ID=driver-wallet-api
OIDC_CLIENT_SECRET=SET_AFTER_CREATING_CONFIDENTIAL_CLIENT
EXPECTED_AUDIENCE=driver-wallet-api
REQUIRED_WALLET_SCOPE=wallet:read
HTTP_TIMEOUT_SECONDS=3
