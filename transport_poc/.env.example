# Copy this file to transport_poc/.env and replace every placeholder locally.
# Never commit .env or reuse these values outside the disposable local lab.
POSTGRES_DB=sanad_local
POSTGRES_USER=sanad_local
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_RANDOM_PASSWORD
KC_BOOTSTRAP_ADMIN_USERNAME=sanad-local-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_DIFFERENT_LOCAL_RANDOM_PASSWORD
KEYCLOAK_HOST_PORT=8080
TRANSPORT_API_PORT=5001
KEYCLOAK_ISSUER=http://keycloak-transport:8080/realms/sanad-lab
OIDC_CLIENT_ID=driver-wallet-api
OIDC_CLIENT_SECRET=SET_AFTER_CREATING_LOCAL_CONFIDENTIAL_CLIENT
EXPECTED_AUDIENCE=driver-wallet-api
REQUIRED_WALLET_SCOPE=wallet:read
HTTP_TIMEOUT_SECONDS=3
