# Copy to .env locally, then replace every placeholder with fresh values.
POSTGRES_DB=keycloak_transport
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=CHANGE_ME_TO_A_NEW_RANDOM_PASSWORD
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_TO_A_DIFFERENT_RANDOM_PASSWORD
TRANSPORT_KC_HTTP_PORT=8180
TRANSPORT_API_PORT=5001
